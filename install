#!/bin/bash
# SMBDM Agent is now Hermlo. This is the old one-line setup address (https://smbdm-team.github.io/smbdm-agent-get/install): it
# only says which line to paste instead (scripts/publish-get.sh --forwarder), and exits 1.
main() {
  local line="curl -fsSL https://smbdm-team.github.io/hermlo-get/install | bash" what="It moves your SMBDM Agent setup over: same link, same sign-in."
  case " $* " in
    *" --uninstall "*)
      line="curl -fsSL https://smbdm-team.github.io/hermlo-get/install | bash -s -- --uninstall"
      what="It removes SMBDM Agent too."
      ;;
  esac
  echo "SMBDM Agent is now Hermlo. Run this instead:" >&2
  echo "  $line" >&2
  echo "$what" >&2
  exit 1
}

main "$@"
