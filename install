#!/bin/bash
# Hermlet: one-line setup for your own Mac (published at https://smbdm-team.github.io/hermlet-get/install).
#
#   curl -fsSL https://smbdm-team.github.io/hermlet-get/install | bash                     set up, update or repair
#   curl -fsSL https://smbdm-team.github.io/hermlet-get/install | bash -s -- --uninstall   remove it
#
# Downloads Hermlet 0.10.10, checks the download is the published one (SHA-256), runs its
# installer with your keyboard (it asks for a username and password), then deletes the download.
# This file holds no secrets. Exit codes are the installer's (team-setup.md); 10-12 are this file's.
# Hermlet used to be called SMBDM Agent: its installer moves those installs over.
#
# Everything is inside main(), called on the last line: if the download is cut off, nothing runs.
set -euo pipefail

main() {
  local url="${HERMLET_KIT_URL:-https://github.com/Smbdm-Team/hermlet-get/releases/download/v0.10.10/hermlet-kit-0.10.10.zip}"
  local sha="${HERMLET_KIT_SHA256:-9b0326ea9cd1aad132230a1a5b17e6fd831164f20df08cb59df297dbb39eac96}"
  local tty="${HERMLET_TTY:-/dev/tty}"
  local tmp got kit

  if [ "$(uname -s)" != Darwin ]; then
    echo "This line sets Hermlet up on a Mac. On Windows, paste this into PowerShell instead:" >&2
    echo "  irm https://smbdm-team.github.io/hermlet-get/install.ps1 | iex" >&2
    echo "On Linux, ask the tech team." >&2
    exit 3
  fi
  if ! { : <"$tty"; } 2>/dev/null; then
    echo "Paste this line into the Terminal app (it asks you for a password, so it needs a keyboard)." >&2
    exit 10
  fi

  echo "Downloading Hermlet 0.10.10..."
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/hermlet.XXXXXX")"
  # shellcheck disable=SC2064 # expand now: tmp is local
  trap "rm -rf '$tmp'" EXIT
  if ! curl -fsSL --retry 2 -m 300 "$url" -o "$tmp/kit.zip" </dev/null; then
    echo "STOPPED: couldn't download Hermlet. Check the internet connection and paste the line again." >&2
    exit 11
  fi
  got="$(shasum -a 256 "$tmp/kit.zip" | cut -d' ' -f1)"
  if [ "$got" != "$sha" ]; then
    echo "STOPPED: the download isn't the published Hermlet (its checksum doesn't match), so it" >&2
    echo "wasn't run. Paste the line again; if it happens again, tell the tech team." >&2
    exit 12
  fi
  unzip -q "$tmp/kit.zip" -d "$tmp/kit"
  kit="$(find "$tmp/kit" -mindepth 2 -maxdepth 2 -name install.sh -print -quit)"
  if [ -z "$kit" ]; then
    echo "STOPPED: the download has no installer in it. Tell the tech team." >&2
    exit 12
  fi
  local rc=0
  bash "$kit" "$@" <"$tty" || rc=$?
  return "$rc"
}

main "$@"
